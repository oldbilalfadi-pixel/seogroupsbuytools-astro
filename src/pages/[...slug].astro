---
export async function getStaticPaths() {
  const fs = await import('node:fs');
  const path = await import('node:path');
  const root = path.resolve(process.cwd(), 'content');
  function allPages(dir) {
    return fs.readdirSync(dir, { withFileTypes: true }).flatMap(entry => {
      const file = path.join(dir, entry.name);
      if (entry.isDirectory()) return allPages(file);
      if (!entry.name.endsWith('.json') || entry.name === 'settings.json') return [];
      return [JSON.parse(fs.readFileSync(file, 'utf8'))];
    });
  }
  return allPages(root)
    .filter(page => page.route !== '/404/')
    .map(page => ({
      params: { slug: page.route === '/' ? undefined : page.route.replace(/^\/|\/$/g, '') },
      props: { page }
    }));
}
const { page } = Astro.props;
let renderedHtml = page.html;
for (const section of page.sections || []) {
  if (!section.source) continue;
  if (typeof section.text === 'string' && section.text !== section.originalText) {
    const openTag = section.source.match(/^<[^>]+>/)?.[0];
    const closeTag = section.source.match(/<\\/[^>]+>$/)?.[0];
    if (openTag && closeTag) {
      const safe = section.text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      renderedHtml = renderedHtml.replace(section.source, openTag + safe + closeTag);
    }
    continue;
  }
  if (typeof section.content !== 'string' || section.content === section.original) continue;
  const open = section.source.match(/^<[^>]+>/)?.[0];
  const close = section.source.match(/<\/[^>]+>$/)?.[0];
  if (!open || !close) continue;
  renderedHtml = renderedHtml.replace(section.source, open + section.content + close);
}

for (const link of page.links || []) {
  if (!link.source || (link.url === link.originalUrl && link.text === link.originalText)) continue;
  let updated = link.source;
  if (link.url !== link.originalUrl) updated = updated.replace('href="' + link.originalUrl + '"', 'href="' + String(link.url).replace(/&/g, '&amp;').replace(/"/g, '&quot;') + '"');
  if (link.text !== link.originalText) updated = updated.replace(/(>)[^<>]*(<\/a>)$/i, (_, a, b) => a + String(link.text).replace(/&/g, '&amp;').replace(/</g, '&lt;') + b);
  renderedHtml = renderedHtml.replace(link.source, updated);
}
for (const image of page.images || []) {
  if (!image.source || (image.src === image.originalSrc && image.alt === image.originalAlt)) continue;
  let updated = image.source;
  if (image.src !== image.originalSrc) updated = updated.replace('src="' + image.originalSrc + '"', 'src="' + String(image.src).replace(/&/g, '&amp;').replace(/"/g, '&quot;') + '"');
  if (image.alt !== image.originalAlt) updated = updated.replace('alt="' + image.originalAlt + '"', 'alt="' + String(image.alt).replace(/&/g, '&amp;').replace(/"/g, '&quot;') + '"');
  renderedHtml = renderedHtml.replace(image.source, updated);
}
if (page.route === '/' && page.hero) {
  const escapeHtml = (value) => String(value ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  const heading = escapeHtml(page.hero.headingBefore) + '<span class="hero-highlight">' + escapeHtml(page.hero.headingHighlight) + '</span>' + escapeHtml(page.hero.headingAfter);
  renderedHtml = renderedHtml.replace(/(<h1>)[\s\S]*?(<\/h1>)/i, (_, start, end) => start + heading + end);
  renderedHtml = renderedHtml.replace(/(<p class="hero-live-desc">)[\s\S]*?(<\/p>)/i, (_, start, end) => start + escapeHtml(page.hero.description) + end);
}

---
<Fragment set:html={renderedHtml} />
